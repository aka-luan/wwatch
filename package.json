{
  "name": "wwatch",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prestart": "vite build",
    "start": "tsx src/server.ts",
    "dev": "vite build && concurrently -k -n web,api -c cyan,magenta \"vite build --watch\" \"tsx watch src/server.ts\"",
    "build": "vite build",
    "test": "tsx --test src/*.test.ts src/**/*.test.ts web/**/*.test.ts",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit && tsc --noEmit -p tsconfig.web.json",
    "preverify": "vite build",
    "verify": "tsx scripts/verify.ts"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "concurrently": "^10.0.5",
    "eslint": "^10.8.1",
    "globals": "^17.11.0",
    "tailwindcss": "^4.3.3",
    "tsx": "^4.23.12",
    "typescript": "~6.0.3",
    "typescript-eslint": "^8.67.0",
    "vite": "^8.2.1"
  },
  "dependencies": {
    "@base-ui/react": "^1.7.0",
    "@hono/node-server": "^2.1.0",
    "@libsql/client": "^0.17.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.2",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "shadcn": "^4.18.0",
    "sonner": "^2.0.8",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0"
  }
}
